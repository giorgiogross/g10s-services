---
import Base from "../layouts/Base.astro";

const pageTitle = "g10s — Giorgio, product engineer";
const pageDescription =
  "I'm Giorgio, a product engineer. I build custom software for small, culture-driven brands in music, art, fashion, and sport. Case studies and past projects.";

type CaseStudy = {
  href: string;
  external?: boolean;
  thumb: string;
  thumbClass?: string;
  title: string;
  titleClass: string;
  bbInitial?: boolean;
};

const caseStudies: CaseStudy[] = [
  {
    href: "https://mosaiic.xyz",
    external: true,
    thumb: "/mosaiic-thumb.webp",
    title: "mosaïc",
    titleClass: "case-card__title--mosaiic",
  },
  {
    href: "/1-800-demo/",
    thumb: "/1-800-demo/thumb.webp",
    title: "1-800 GIRLS",
    titleClass: "case-card__title--pixel",
  },
  {
    href: "https://batchbrew.xyz",
    external: true,
    thumb: "/bb-lp/bb-lp-thumb.webp",
    title: "atchbrew",
    titleClass: "case-card__title--bb",
    bbInitial: true,
  },
  {
    href: "/cirali/",
    thumb: "/cirali/thumb.webp",
    thumbClass: "case-card__thumb--cirali",
    title: "Cirali",
    titleClass: "case-card__title--cirali",
  },
];

type Project = {
  logo: string;
  title: string;
  summary?: string;
  body?: string;
  video?: string;
  embed?: "instagram";
  href?: string;
  cta?: string;
};

const projects: Project[] = [
  {
    logo: "/bb_logo.svg",
    title: "Batchbrew",
    summary: "Creative workspace with AI integrations",
    body: "Add inspiration and research to collaborative whiteboards and sync your data across all your devices. Automatically creates a searchable library for your curated saves. Built solo, where competitors need 4-person teams for the same thing.",
    href: "https://batchbrew.xyz",
    cta: "Go to Batchbrew",
  },
  {
    logo: "/wave-sine.svg",
    title: "Camera Control Synthesizer",
    summary: "An instrument you play with your webcam",
    video: "https://cofzhirmlrbeifndntdo.supabase.co/storage/v1/object/public/product-images/g10s-services-assets/cam-controlled-synth.MOV",
  },
  {
    logo: "/convert-shapes.svg",
    title: "Sample-to-Synthesizer tool",
    summary: "Turns mp3 samples into playable instruments",
    embed: "instagram",
    href: "https://www.instagram.com/p/DYuRNlWsGBX/",
    cta: "Open on Instagram",
  },
  {
    logo: "/scalable-logo.svg",
    title: "Scalable",
    summary: "From zero to the first 2,000 users",
    body: "Joined a non-technical founder as first engineer on a bootstrapped team. Contributed to the technical foundation while we were scaling from zero to the first 2k users. Now building marketing automation flows that make a part time marketing role execute the work of 4 FTEs.",
    href: "https://www.scalable.so/",
    cta: "Go to Scalable",
  },
  {
    logo: "/reelio-logo.svg",
    title: "Reelio",
    summary: "Deliver Netflix-quality videos to online stores",
    body: "Video streaming infrastructure for ecommerce, with adaptive bitrate, edge delivery, and a lightweight player tuned for product pages. Sold to a different owner in an early pre-revenue phase.",
    href: "https://reelio.io/",
    cta: "Go to Reelio",
  },
  {
    logo: "/hand-sparkles-filled.svg",
    title: "Gesture Controlled Whiteboard",
    summary: "Control your mood board with your web cam",
    body: "A UX experiment where I built out a touch-less UX concept for my whiteboard app. Users can pan, zoom and drag using their hands.",
    embed: "instagram",
    href: "https://www.instagram.com/p/DW3p7quDG0K/",
    cta: "Open on Instagram",
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <!-- ============================================================
       BRAND — fixed top-left logo
       ============================================================ -->
  <a href="/" class="brand" aria-label="g10s home">
    <span class="brand-mark" aria-hidden="true"></span>
  </a>

  <!-- ============================================================
       LET'S TALK — persistent bottom-center CTA
       ============================================================ -->
  <a href="mailto:lab@g10s.xyz" class="talk-bar liquid-glass" aria-label="Let's talk">
    <span class="talk-bar__label">Let's talk</span>
    <span class="talk-bar__pill" aria-hidden="true">
      <img
        class="talk-bar__icon talk-bar__icon--closed"
        src="/phone-closed-white-48x48.svg"
        alt=""
        width="22"
        height="22"
        decoding="async"
      />
      <img
        class="talk-bar__icon talk-bar__icon--open"
        src="/phone-open-white-48x48.svg"
        alt=""
        width="22"
        height="22"
        decoding="async"
      />
    </span>
  </a>

  <!-- ============================================================
       ABOUT — bio (left) + scrollable case studies / projects (right)
       ============================================================ -->
  <section class="section about-section reveal">
    <div class="about-grid">
      <div class="about-content">
        <article class="about-tweet">
          <div class="about-photo" role="img" aria-label="Giorgio"></div>
          <div class="about-tweet__body-col">
            <header class="about-tweet__identity">
              <h1 class="about-tweet__name">Giorgio</h1>
              <span class="about-tweet__handle">@g10s.xyz</span>
            </header>
            <p class="about-tweet__body">
              Hi, I'm Giorgio.
              <br />
              I'm a growth engineer, building tools and workflows for small teams
              to help them run and grow their business more effectively.
              <br /><br />
              I worked a decade as a product engineer who's designed and built entire apps before
              ai was a thing: my own projects, and for small teams going from
              their first dozen to their first thousands of users.
              <br /><br />
              I love music, third spaces, great design, athleticism, and brands
              that touch culture in a meaningful way. I want to build internal
              tools, AI workflows, reporting tools or even entire apps and
              customer experiences for such brands.
              <br /><br />
              If you find yourself repeatedly investing hours to go through
              websites and excel sheets, prepping up data to make better
              decisions, organising designs and new releases for social media
              posts, or needing to hire more people than you can find, let's
              talk.
            </p>
            <div class="about-socials">
              <a
                href="https://www.instagram.com/g10s.xyz/"
                target="_blank"
                rel="noopener noreferrer"
                class="about-social"
                aria-label="Giorgio on Instagram"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.85 5.85 0 0 0-2.12 1.38A5.85 5.85 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.8.73 1.48 1.38 2.12.64.65 1.32 1.07 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.85 5.85 0 0 0 2.12-1.38 5.85 5.85 0 0 0 1.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.85 5.85 0 0 0-1.38-2.12A5.85 5.85 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84zm0 10.16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"
                  />
                </svg>
              </a>
              <a
                href="https://www.linkedin.com/in/giorgiogross/"
                target="_blank"
                rel="noopener noreferrer"
                class="about-social"
                aria-label="Giorgio on LinkedIn"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                  <path
                    fill="currentColor"
                    d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.15 1.45-2.15 2.95v5.66H9.34V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.56V9h3.56v11.45zM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0z"
                  />
                </svg>
              </a>
            </div>
          </div>
        </article>
      </div>

      <div class="about-projects">
        <div class="projects-group">
          <div class="projects-label">Recent projects</div>
          <div class="case-grid">
            {caseStudies.map((c) => (
              <a
                href={c.href}
                class="case-card"
                {...(c.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >
                <img
                  class={`case-card__thumb${c.thumbClass ? ` ${c.thumbClass}` : ""}`}
                  src={c.thumb}
                  width="72"
                  height="72"
                  alt=""
                  aria-hidden="true"
                  loading="lazy"
                  decoding="async"
                />
                <div class="case-card__body">
                  <span class={`case-card__title ${c.titleClass}`}>
                    {c.bbInitial && (
                      <span class="case-card__title-bb-initial">B</span>
                    )}{c.title}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

        <div class="projects-group">
          <div class="projects-label">More projects</div>
          <div class="project-stack">
            {projects.map((p) => (
              <div class="project-card" data-embed={p.embed}>
                <button type="button" class="project-card__header" data-project-toggle>
                  <span class="project-card__logo">
                    <img src={p.logo} alt="" aria-hidden="true" />
                  </span>
                  <div class="project-card__info">
                    <h3>{p.title}</h3>
                    {p.summary && <span>{p.summary}</span>}
                  </div>
                  <span class="project-card__icon" aria-hidden="true">+</span>
                </button>
                <div class="project-card__body">
                  <div class="project-card__body-inner">
                    {p.video ? (
                      <div class="project-card__video">
                        <video
                          data-project-video
                          data-src={p.video}
                          preload="none"
                          controls
                          playsinline
                        ></video>
                      </div>
                    ) : (
                      <>
                        {p.body && <p>{p.body}</p>}
                        {p.embed === "instagram" && p.href && (
                          <div class="project-card__embed">
                            <blockquote
                              class="instagram-media"
                              data-instgrm-permalink={p.href}
                              data-instgrm-version="14"
                            >
                              <a href={p.href}>View on Instagram</a>
                            </blockquote>
                          </div>
                        )}
                      </>
                    )}
                    {p.href && p.cta && (
                      <div class="project-card__cta">
                        <a href={p.href} target="_blank" rel="noopener noreferrer">{p.cta}</a>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       FOOTER
       ============================================================ -->
  <footer class="foot">
    <span>g10s</span>
    <span>Cologne, Lisbon</span>
    <nav class="foot-links">
      <a href="/legal/">Legal Notice</a>
      <a href="/privacy/">Privacy Policy</a>
    </nav>
  </footer>
</Base>
