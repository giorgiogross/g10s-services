# Waitlist (server only). Batchbrew Supabase project, schema g10s_data, table mailing_list (migration lives in giorgiogross/margatsni).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postmark server "Batchbrew Transactional Emails"; template alias g10s-waitlist-confirm (model: confirm_url).
POSTMARK_TX_SMTP_API_KEY=
POSTMARK_SENDER_EMAIL=
# Optional overrides
# POSTMARK_WAITLIST_TEMPLATE_ALIAS=g10s-waitlist-confirm
# POSTMARK_MESSAGE_STREAM=outbound

# Base of the emailed confirm link; defaults to the request origin.
# SITE_URL=https://g10s.xyz
